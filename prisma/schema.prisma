generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  email     String   @unique
  joinDate  DateTime @default(now())
  role      Role     @default(USER)
  isDeleted Boolean  @default(false)
  isEmailVerified Boolean @default(false)

  auth      Auth?
  stories   Story[]
}

model Auth {
  userId String @id

  password String
  passwordLastModificationTime DateTime

  passwordChangeToken String?
  isPasswordChangeTokenValid Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Story {
  storyId   String   @id @default(uuid())
  title     String
  body      String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seriesTitle String?
  seriesOrder Int?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories  Category[]
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  stories     Story[]
}