{
    "name": "web-tales-backend",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc && npm run copy-assets",
        "start": "node dist/server.js",
        "copy-assets": "copyfiles -u 1 \"src/docs/**/*\" dist",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "prepare": "husky || true",
        "swagger": "tsx src/config/swagger.ts",
        "prestart": "npm run swagger",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "node node_modules/eslint/bin/eslint.js --fix",
            "node node_modules/prettier/bin/prettier.cjs --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mr-mahfuj/web-tales-backend.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/mr-mahfuj/web-tales-backend/issues"
    },
    "homepage": "https://github.com/mr-mahfuj/web-tales-backend#readme",
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^6.19.3",
        "@types/js-yaml": "^4.0.9",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "js-yaml": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "resend": "^6.20.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.5.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.0.0",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "copyfiles": "^2.4.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.0.8",
        "prettier": "^3.8.4",
        "prisma": "^6.19.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    }
}
